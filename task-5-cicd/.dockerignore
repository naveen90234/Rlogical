# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ─── SQLite database files (runtime data, not part of the image) ──────────────
db/
*.db
*.sqlite
*.sqlite3

# ─── Test files (not needed in production image) ──────────────────────────────
spec/
*.test.js
*.spec.js
jest.config.*
coverage/

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.cert

# ─── Docker files (not needed inside the image itself) ────────────────────────
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
compose.yaml

# ─── Version control ──────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ─── CI / CD ──────────────────────────────────────────────────────────────────
.github/

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Documentation ────────────────────────────────────────────────────────────
README.md
